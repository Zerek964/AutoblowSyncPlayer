<Window x:Class="AutoblowSyncPlayer.App.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autoblow Sync Player" Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        AllowsTransparency="True">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- App Icon -->
            <Image Source="/Assets/AppIcon.png" Width="48" Height="48" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            
            <!-- App Name -->
            <TextBlock Text="Autoblow Sync Player" 
                      FontSize="18" FontWeight="Bold" 
                      HorizontalAlignment="Center"
                      Margin="0,0,0,10"/>
            
            <!-- Loading Indicator -->
            <TextBlock x:Name="StatusText" 
                      Text="Loading..." 
                      FontSize="12" 
                      Foreground="#666666"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"/>
            
            <!-- Progress Bar -->
            <ProgressBar IsIndeterminate="True" 
                        Height="4" 
                        Width="300"
                        Margin="0,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
