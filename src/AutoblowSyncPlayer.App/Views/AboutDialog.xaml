<Window x:Class="AutoblowSyncPlayer.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#3C3C3C"
        Foreground="White"
        Icon="/Assets/AppIcon.png">

    <Grid Margin="20">
        <StackPanel>
            <!-- App Icon -->
            <Image Source="/Assets/AppIcon.png" Width="48" Height="48" Margin="0,0,0,10" HorizontalAlignment="Center"/>

            <!-- App Title -->
            <TextBlock x:Name="ContentDialog"
                      FontSize="20" FontWeight="Bold" 
                      Margin="0,0,0,10"
                      TextAlignment="Center"/>

            <!-- Description -->
            <TextBlock FontSize="14" 
                      Text="Synchronize Autoblow device playback with local MP4 videos using .funscript files."
                      TextWrapping="Wrap" 
                      Margin="0,0,0,20"
                      TextAlignment="Center"/>

            <!-- Tech details -->
            <Border BorderBrush="#555555" BorderThickness="1" 
                    CornerRadius="4" Padding="10" Margin="0,0,0,20"
                    Background="#2D2D2D">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">Technology Stack</TextBlock>
                    <TextBlock Text="• .NET 10 + WPF"/>
                    <TextBlock Text="• LibVLC for video playback"/>
                    <TextBlock Text="• MVVM Architecture"/>
                    <TextBlock Text="• Real-time sync engine"/>
                </StackPanel>
            </Border>

            <!-- Links -->
            <TextBlock Text="GitHub: https://github.com/AutoblowSyncPlayer" 
                      Foreground="#6CB4EE" 
                      TextDecorations="Underline"
                      Cursor="Hand"
                      Margin="0,0,0,20"/>

            <!-- OK Button -->
            <Button Content="OK" 
                    HorizontalAlignment="Center" 
                    Width="100" 
                    Padding="0,5"/>
        </StackPanel>
    </Grid>
</Window>
